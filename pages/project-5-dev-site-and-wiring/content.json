      "type": "bulletListItem",
      "props": {
        "backgroundColor": "default",
        "textColor": "default",
        "textAlignment": "left"
      },
      "content": [
        {
          "type": "text",
          "text": "at least 2 github issues assigned per team member in github",
          "styles": {}
        }
      ],
      "children": []
    },
    {
      "id": "bc374f19-dd7c-44ff-92b9-5ce2e2c3b4e1",
      "type": "bulletListItem",
      "props": {
        "backgroundColor": "default",
        "textColor": "default",
        "textAlignment": "left"
      },
      "content": [
        {
          "type": "text",
          "text": "update your ",
          "styles": {}
        },
        {
          "type": "link",
          "href": "http://README.md",
          "content": [
            {
              "type": "text",
              "text": "README.md",
              "styles": {}
            }
          ]
        },
        {
          "type": "text",
          "text": " files on frontend and backend to have",
          "styles": {}
        }
      ],
      "children": [
        {
          "id": "0c899edc-a800-4151-81ab-64a074bcc371",
          "type": "bulletListItem",
          "props": {
            "backgroundColor": "default",
            "textColor": "default",
            "textAlignment": "left"
          },
          "content": [
            {
              "type": "text",
              "text": "dev urls",
              "styles": {}
            }
          ],
          "children": [
            {
              "id": "81640026-190f-4ce4-b308-481bc2ac9ea2",
              "type": "bulletListItem",
              "props": {
                "backgroundColor": "default",
                "textColor": "default",
                "textAlignment": "left"
              },
              "content": [
                {
                  "type": "text",
                  "text": "url of frontend",
                  "styles": {}
                }
              ],
              "children": []
            },
